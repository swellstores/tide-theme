        "link_href": "/products",
        "products": {
          "from": "all",
          "sort": "best_selling",
          "limit": 4
        }
      }
    },
    {
      "id": "newsletter",
      "type": "email_signup",
      "props": {
        "heading": "Stay in touch",
        "text": "Sign up to get emails from us.",
        "button_label": "Subscribe"
      }
    }
  ]
}
